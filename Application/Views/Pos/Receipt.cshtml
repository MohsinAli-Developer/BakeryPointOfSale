@model Application.Models.Sale
@{
    Layout = null;
    var productNames = (Dictionary<int, string>)ViewBag.ProductNames;
    var cashier = (string)ViewBag.Cashier;
    var totalQty = Model.Details.Sum(d => d.Quantity);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Receipt @Model.InvoiceNo</title>
    <style>
        @@page {
            size: 80mm auto;
            margin: 0;
        }

        body {
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 12px;
            width: 76mm;
            margin: 4mm auto;
            color: #000;
        }

        .center {
            text-align: center;
        }

        .bold {
            font-weight: bold;
        }

        .line {
            border-top: 1px dashed #000;
            margin: 4px 0;
        }

        .row {
            display: flex;
            justify-content: space-between;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        th, td {
            padding: 2px 0;
        }

        th {
            text-align: left;
            border-bottom: 1px dashed #000;
        }

        .r {
            text-align: right;
        }

        .total-row {
            font-weight: bold;
            font-size: 14px;
        }

        .actions {
            text-align: center;
            margin-top: 10px;
        }

        @@media print {
            body {
                margin: 0;
            }

            .actions {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="center bold" style="font-size:15px;">🥖 BAKERY POS</div>
    <div class="center small">Welcome!</div>
    <div class="line"></div>

    <div class="row"><span>Invoice</span><span>@Model.InvoiceNo</span></div>
    <div class="row"><span>Date</span><span>@Model.SaleDate.ToString("dd/MM/yyyy HH:mm")</span></div>
    <div class="row"><span>Cashier</span><span>@cashier</span></div>
    <div class="line"></div>

    <table>
        <thead>
            <tr>
                <th>Item</th>
                <th class="r">Qty</th>
                <th class="r">Price</th>
                <th class="r">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Details)
            {
                var name = productNames.TryGetValue(d.ProductId, out var n) ? n : "Item #" + d.ProductId;
                <tr>
                    <td>@name</td>
                    <td class="r">@d.Quantity.ToString("0.###")</td>
                    <td class="r">@d.UnitPrice.ToString("N2")</td>
                    <td class="r">@d.TotalAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="line"></div>

    <div class="row"><span>Items</span><span>@totalQty</span></div>
    <div class="row"><span>Subtotal</span><span>@Model.SubTotal.ToString("N2")</span></div>
    @if (Model.Discount > 0)
    {
        <div class="row"><span>Discount</span><span>- @Model.Discount.ToString("N2")</span></div>
    }
    <div class="row total-row"><span>TOTAL</span><span>₨ @Model.GrandTotal.ToString("N2")</span></div>
    <div class="row"><span>Paid (@Model.PaymentMethod)</span><span>@Model.PaidAmount.ToString("N2")</span></div>
    @if (Model.RemainingAmount > 0)
    {
        <div class="row"><span>Remaining</span><span>@Model.RemainingAmount.ToString("N2")</span></div>
    }

    <div class="line"></div>
    <div class="center">Thank you! Please come again.</div>
    <div class="center small">Powered by Bakery POS</div>

    <div class="actions">
        <button onclick="window.print()">🖨️ Print</button>
        <button onclick="window.close()">Close</button>
    </div>

    <script>
        window.addEventListener('load', () => setTimeout(() => window.print(), 200));
    </script>
</body>
</html>