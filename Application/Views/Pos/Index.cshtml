                    </thead>
                    <tbody id="cartBody"></tbody>
                </table>
                <div id="cartEmpty" class="cart-empty">
                    <div class="em">🧾</div>
                    <div>No items yet</div>
                    <div class="small mt-1">Scan / search and press <kbd>Enter</kbd></div>
                </div>
            </div>

            <div class="cart-footer">
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>₨ <span id="subTotal">0.00</span></span>
                </div>
                <div class="summary-row">
                    <label for="discountInput">Discount</label>
                    <input id="discountInput" type="number" min="0" step="0.01" value="0" class="form-control form-control-sm d-inline-block" />
                </div>
                <div class="summary-row grand">
                    <span>Total</span>
                    <span>₨ <span id="grandTotal">0.00</span></span>
                </div>
                <div class="summary-row">
                    <label for="paidInput">Paid</label>
                    <input id="paidInput" type="number" min="0" step="0.01" value="0" class="form-control form-control-sm d-inline-block" />
                </div>
                <div class="summary-row">
                    <label for="paymentSelect">Payment</label>
                    <select id="paymentSelect" class="form-select form-select-sm" style="width:130px;">
                        @foreach (var m in Model.PaymentMethods)
                        {
                            <option value="@m">@m</option>
                        }
                    </select>
                </div>
                <div class="summary-row">
                    <span>Change / Remaining</span>
                    <span>₨ <span id="remainingAmt">0.00</span></span>
                </div>

                <button id="checkoutBtn" class="btn btn-success btn-checkout mt-2">
                    ✅ Complete Sale (F10)
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        (function () {
            const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.Products,
                            new System.Text.Json.JsonSerializerOptions
                            {
                                    PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                            }));

        const cart = [];

            const $search    = document.getElementById('searchBox');
            const $grid      = document.getElementById('productGrid');
            const $cartBody  = document.getElementById('cartBody');
            const $cartEmpty = document.getElementById('cartEmpty');
            const $sub       = document.getElementById('subTotal');
            const $grand     = document.getElementById('grandTotal');
            const $discount  = document.getElementById('discountInput');
            const $paid      = document.getElementById('paidInput');
            const $payMethod = document.getElementById('paymentSelect');
            const $remain    = document.getElementById('remainingAmt');
            const $checkout  = document.getElementById('checkoutBtn');
            const $clear     = document.getElementById('clearCartBtn');

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const fmt = n => Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            function flash(msg, type) {
                var el = document.createElement('div');
                el.className = 'flash ' + (type || 'ok');
                el.textContent = msg;
                document.body.appendChild(el);
                setTimeout(function () { el.remove(); }, 2200);
            }

            function subTotal() { return cart.reduce(function (s, i) { return s + i.price * i.qty; }, 0); }
            function grandTotal() {
                var st = subTotal();
                var d  = Math.min(Number($discount.value) || 0, st);
                return Math.max(0, st - d);
            }
            function refreshTotals() {
                var st = subTotal();
                var gt = grandTotal();
                var paid = Number($paid.value) || 0;
                $sub.textContent    = fmt(st);
                $grand.textContent  = fmt(gt);
                $remain.textContent = fmt(Math.max(0, gt - paid));
            }

            function addToCart(productId, qty) {
                qty = qty || 1;
                var p = null;
                for (var i = 0; i < products.length; i++) {
                    if (products[i].productId === productId) { p = products[i]; break; }
                }
                if (!p) return;

                var existing = null;
                for (var j = 0; j < cart.length; j++) {
                    if (cart[j].productId === productId) { existing = cart[j]; break; }
                }
                if (existing) {
                    existing.qty += qty;
                } else {
                    cart.push({
                        productId: p.productId,
                        name: p.productName || '',
                        unit: p.unit || 'Pcs',
                        price: Number(p.salePrice) || 0,
                        qty: qty
                    });
                }
                renderCart();
                if (Number($paid.value) === 0) {
                    $paid.value = grandTotal().toFixed(2);
                    refreshTotals();
                }
            }

            function findByInput(text) {
                text = (text || '').trim();
                if (!text) return null;

                var i;
                for (i = 0; i < products.length; i++) {
                    if (products[i].barcode && products[i].barcode === text) return products[i];
                }
                if (/^\d+$/.test(text)) {
                    var id = Number(text);
                    for (i = 0; i < products.length; i++) {
                        if (products[i].productId === id) return products[i];
                    }
                }
                var lower = text.toLowerCase();
                for (i = 0; i < products.length; i++) {
                    var nm = (products[i].productName || '').toLowerCase();
                    if (nm.indexOf(lower) !== -1) return products[i];
                }
                return null;
            }

            function renderCart() {
                $cartBody.innerHTML = '';
                $cartEmpty.style.display = cart.length === 0 ? 'block' : 'none';

                for (var idx = 0; idx < cart.length; idx++) {
                    var item = cart[idx];
                    var tr = document.createElement('tr');
                    tr.innerHTML =
                        '<td>' +
                            '<div class="fw-semibold">' + escapeHtml(item.name) + '</div>' +
                            '<div class="small text-muted">₨ ' + fmt(item.price) + ' / ' + escapeHtml(item.unit) + '</div>' +
                        '</td>' +
                        '<td>' +
                            '<input type="number" min="0.001" step="0.001" value="' + item.qty + '" ' +
                                   'class="form-control form-control-sm qty-input" data-idx="' + idx + '" />' +
                        '</td>' +
                        '<td class="text-end">₨ ' + fmt(item.price) + '</td>' +
                        '<td class="line-total">₨ ' + fmt(item.price * item.qty) + '</td>' +
                        '<td>' +
                            '<button class="btn btn-sm btn-outline-danger px-2 py-0 remove-btn" data-idx="' + idx + '">×</button>' +
                        '</td>';
                    $cartBody.appendChild(tr);
                }

                var qtyInputs = $cartBody.querySelectorAll('.qty-input');
                for (var q = 0; q < qtyInputs.length; q++) {
                    (function (inp) {
                        inp.addEventListener('change', function (e) {
                            var i = Number(e.target.dataset.idx);
                            var v = parseFloat(e.target.value);
                            if (!(v > 0)) { cart[i].qty = 1; e.target.value = 1; }
                            else cart[i].qty = v;
                            renderCart();
                        });
                        inp.addEventListener('keydown', function (e) {
                            if (e.key === 'Enter') { e.preventDefault(); e.target.blur(); }
                        });
                    })(qtyInputs[q]);
                }

                var removeBtns = $cartBody.querySelectorAll('.remove-btn');
                for (var r = 0; r < removeBtns.length; r++) {
                    (function (btn) {
                        btn.addEventListener('click', function (e) {
                            cart.splice(Number(e.target.dataset.idx), 1);
                            renderCart();
                        });
                    })(removeBtns[r]);
                }

                refreshTotals();
            }

            function escapeHtml(s) {
                return String(s).replace(/[&<>"']/g, function (c) {
                    return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
                });
            }

            function runSearch() {
                var text = $search.value.trim();
                if (!text) return;

                var p = findByInput(text);
                if (p) {
                    addToCart(p.productId, 1);
                    $search.value = '';
                } else {
                    flash('No product matched: ' + text, 'err');
                    $search.select();
                }
            }

            $search.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); runSearch(); }
                if (e.key === 'Escape') { $search.value = ''; }
            });

            $grid.addEventListener('click', function (e) {
                var card = e.target.closest('.product-card');
                if (!card) return;
                addToCart(Number(card.dataset.id), 1);
                $search.focus();
            });

            $discount.addEventListener('input', refreshTotals);
            $paid.addEventListener('input', refreshTotals);

            $clear.addEventListener('click', function () {
                cart.length = 0;
                $discount.value = 0;
                $paid.value = 0;
                renderCart();
                $search.focus();
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'F2') { e.preventDefault(); $search.focus(); $search.select(); }
                if (e.key === 'F10') { e.preventDefault(); doCheckout(); }
                if (e.key === 'Escape' && document.activeElement.tagName !== 'INPUT'
                    && document.activeElement.tagName !== 'SELECT') {
                    $search.focus();
                }
            });

            function doCheckout() {
                if (cart.length === 0) { flash('Cart is empty.', 'err'); return; }

                var st   = subTotal();
                var disc = Math.min(Number($discount.value) || 0, st);
                var gt   = Math.max(0, st - disc);
                var paid = Number($paid.value) || 0;

                if (paid < gt) {
                    if (!confirm('Paid amount (₨ ' + fmt(paid) + ') is less than total (₨ ' + fmt(gt) + '). Continue with remaining ₨ ' + fmt(gt - paid) + '?'))
                        return;
                }

                var items = [];
                for (var i = 0; i < cart.length; i++) {
                    items.push({
                        productId: cart[i].productId,
                        quantity: cart[i].qty,
                        unitPrice: cart[i].price,
                        discount: 0,
                        totalAmount: cart[i].price * cart[i].qty
                    });
                }

                var body = {
                    subTotal: st,
                    discount: disc,
                    grandTotal: gt,
                    paidAmount: paid,
                    paymentMethod: $payMethod.value,
                    items: items
                };

                $checkout.disabled = true;
                fetch('/Pos/Checkout', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(body)
                })
                .then(function (res) {
                    return res.json().then(function (data) { return { ok: res.ok, data: data }; });
                })
                .then(function (result) {
                    if (!result.ok) {
                        flash(result.data.message || 'Checkout failed', 'err');
                        return;
                    }
                    flash('✅ Sale saved • ' + result.data.invoiceNo, 'ok');
                    cart.length = 0;
                    $discount.value = 0;
                    $paid.value = 0;
                    renderCart();
                    window.open('/Pos/Receipt/' + result.data.saleId, '_blank');
                    $search.focus();
                })
                .catch(function (err) {
                    flash('Network error: ' + err.message, 'err');
                })
                .then(function () {
                    $checkout.disabled = false;
                });
            }

            $checkout.addEventListener('click', doCheckout);

            renderCart();
            $search.focus();
        })();
    </script>
}