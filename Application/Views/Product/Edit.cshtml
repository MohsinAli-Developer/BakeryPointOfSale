@model Application.Models.ProductFormViewModel
@{
    ViewData["Title"] = "Edit Product";
    ViewData["Active"] = "Product";
    Layout = "_Layout";
}

<h3 class="mb-3">✏️ Edit Product</h3>

<div class="card" style="max-width:720px;">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Product.ProductId" method="post">
            <input type="hidden" asp-for="Product.ProductId" />
            <input type="hidden" asp-for="Product.CreatedDate" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Product.ProductName" class="form-label">Product Name</label>
                    <input asp-for="Product.ProductName" class="form-control" />
                    <span asp-validation-for="Product.ProductName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Product.CategoryId" class="form-label">Category</label>
                    <select asp-for="Product.CategoryId"
                            asp-items="Model.Categories"
                            class="form-select">
                        <option value="">-- Select category --</option>
                    </select>
                    <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Product.Barcode" class="form-label">Barcode <span class="text-muted">(optional)</span></label>
                    <input asp-for="Product.Barcode" class="form-control" />
                    <span asp-validation-for="Product.Barcode" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Product.Unit" class="form-label">Unit</label>
                    <select asp-for="Product.Unit" class="form-select">
                        <option value="Pcs">Pcs</option>
                        <option value="Kg">Kg</option>
                        <option value="Gram">Gram</option>
                        <option value="Dozen">Dozen</option>
                        <option value="Pack">Pack</option>
                        <option value="Box">Box</option>
                    </select>
                    <span asp-validation-for="Product.Unit" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Product.SalePrice" class="form-label">Sale Price</label>
                    <input asp-for="Product.SalePrice" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Product.SalePrice" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Product.PurchasePrice" class="form-label">Purchase Price</label>
                    <input asp-for="Product.PurchasePrice" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Product.PurchasePrice" class="text-danger small"></span>
                </div>

                <div class="col-12 form-check ms-2 mt-2">
                    <input asp-for="Product.IsActive" class="form-check-input" />
                    <label asp-for="Product.IsActive" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Update</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>