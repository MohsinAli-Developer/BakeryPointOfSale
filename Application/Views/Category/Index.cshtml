@model List<Application.Models.Category>
@{
    ViewData["Title"] = "Categories";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">🗂️ Categories</h3>
    <a asp-action="Create" class="btn btn-primary">+ New Category</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width:60px;">#</th>
                    <th>Category Name</th>
                    <th style="width:140px;">Status</th>
                    <th style="width:160px;">Created</th>
                    <th style="width:260px;" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No categories yet. Click "New Category" to add one.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CategoryId</td>
                            <td class="fw-semibold">@c.CategoryName</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.CategoryId"
                                   class="btn btn-sm btn-outline-primary">Edit</a>

                                <form asp-action="ToggleActive" asp-route-id="@c.CategoryId"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-warning">
                                        @(c.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>

                                <form asp-action="Delete" asp-route-id="@c.CategoryId"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>